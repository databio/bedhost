# Env for the local dev bedhost backend (loaded by the dash dashboard, which
# sources this file, so every var must be `export`ed to reach the process).
# Local dev database only -- these creds match deployment/dev/docker-compose.yml.
export BEDBASE_PG_HOST=127.0.0.1
export BEDBASE_PG_PORT=15443
export BEDBASE_PG_USER=bedbase
export BEDBASE_PG_PASSWORD=bedbase

# Path to the bbconf config the server reads (bedhost/bedhost/main.py).
# Relative path: start the server from this directory (deployment/dev).
export BEDBASE_CONFIG=bedbase-dev.yaml

# Skip the heavy ReferenceValidator / ML init for the lightweight dev server.
export BEDHOST_INIT_ML=false
